{
  "private": true,
  "scripts": {
    "start": "scripts/kube-tunnel.sh",
    "reconcile:source": "flux reconcile source git flux-system -n flux-system",
    "reconcile:flux": "flux reconcile kustomization flux-system -n flux-system --with-source",
    "apply": "scripts/apply.sh",
    "teardown": "scripts/teardown.sh",
    "encrypt": "scripts/sops-encrypt.sh",
    "decrypt": "scripts/sops-decrypt.sh",
    "lint": "yamllint .",
    "grafana": "scripts/grafana-dashboard.sh",
    "longhorn": "scripts/longhorn-dashboard.sh",
    "traefik": "scripts/traefik-dashboard.sh",
    "format": "prettier --write '**/*.{yaml,yml,json,md}'",
    "format:check": "prettier --check '**/*.{yaml,yml,json,md}'",
    "format:terraform": "tofu fmt -recursive terraform",
    "format:terraform:check": "tofu fmt -check -recursive terraform"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
